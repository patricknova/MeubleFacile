# Configuration Supabase
# Récupérez ces valeurs dans votre tableau de bord Supabase : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Alternativement, NEXT_PUBLIC_SUPABASE_ANON_KEY peut être utilisé :
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clé secrète de service (uniquement pour les scripts d'administration / migrations backend)
# Ne jamais exposer avec le préfixe NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=

# URL du site
NEXT_PUBLIC_SITE_URL=https://meuble-facile.vercel.app

# WhatsApp par défaut pour le contact
NEXT_PUBLIC_WHATSAPP_DEFAULT=+237600000000

# Clé API Google Places (pour l'importation de points d'intérêt)
GOOGLE_PLACES_API_KEY=
